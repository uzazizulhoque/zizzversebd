rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Anyone can browse the shop. Only admins can change it.
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }

    // Customers can create their own profile (always as "customer") and read it.
    // Nobody can promote themselves: only admins can update a user.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Customers can place and read their own orders. Only admins can change status.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total is int && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
